APP_NAME=ClipMind API
DATABASE_URL=postgresql+psycopg://clipmind:change-me@db:5432/clipmind
UPLOAD_DIR=/app/uploads
RENDER_DIR=/app/renders
TMP_DIR=/app/tmp
ALLOWED_ORIGINS=https://app.example.com
MAX_UPLOAD_MB=1024
STORAGE_BACKEND=local
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
YT_DLP_BIN=yt-dlp
YTDLP_MAX_HEIGHT=1080
# Needed alongside a JS runtime (node) for YouTube's signature challenge.
YTDLP_REMOTE_COMPONENTS=ejs:github
# Datacenter IPs trip YouTube's bot check. Mount an exported cookies.txt and
# point this at it; yt-dlp no longer supports OAuth login.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
INGEST_PROVIDER=auto
APIFY_API_TOKEN=
APIFY_YOUTUBE_ACTOR=streamers~youtube-video-downloader
APIFY_YOUTUBE_QUALITY=360
APIFY_YOUTUBE_TIMEOUT_SEC=300

TRANSCRIBE_BACKEND=groq
TRANSCRIBE_ALLOW_MOCK_FALLBACK=false
TRANSCRIBE_GROQ_LOCAL_FALLBACK=false
TRANSCRIBE_ROUTER_ENABLED=false
TRANSCRIBE_LANGUAGE=
GROQ_API_KEY=

MAX_CONCURRENT_RENDER_JOBS=2
MAX_CONCURRENT_INGEST_JOBS=1

PEXELS_API_KEY=
PIXABAY_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=
BROLL_GENERATIVE_API_URL=
BROLL_GENERATIVE_API_KEY=

# --- Transcription accuracy guards (non-English songs) ---
# Must not be under /tmp: a reboot clears it and vocal isolation then fails
# silently, leaving songs transcribed over full backing music.
TRANSCRIBE_VOCAL_ISOLATION_MODEL_DIR=/app/models/audio-separator
# The built-in English music prompt biases non-English audio toward Latin text.
TRANSCRIBE_GROQ_MUSIC_PROMPT_LANGUAGES=en
TRANSCRIBE_RATE_HALLUCINATION_FILTER=true
TRANSCRIBE_MAX_WORDS_PER_SEC=9.0
TRANSCRIBE_REPEAT_LOOP_FILTER=true
TRANSCRIBE_MAX_NGRAM_REPEATS=2
