APP_NAME=ClipMind API
DATABASE_URL=sqlite:///./app.db
UPLOAD_DIR=./uploads
RENDER_DIR=./renders
TMP_DIR=./tmp
# Keep committed defaults secret-free. Put real API keys in backend/.env.local
# for local work or inject them from your deployment platform in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
MAX_UPLOAD_MB=1024
STORAGE_BACKEND=local
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
RENDER_VIDEO_ENCODER=auto
YT_DLP_BIN=yt-dlp
TRANSCRIBE_MODEL=small
TRANSCRIBE_RETRY_MODEL=medium
TRANSCRIBE_DEVICE=auto
TRANSCRIBE_COMPUTE_TYPE=auto
TRANSCRIBE_COMPUTE_TYPE_CUDA=float16
TRANSCRIBE_COMPUTE_TYPE_CPU=int8
TRANSCRIBE_BEAM_SIZE=5
TRANSCRIBE_RETRY_BEAM_SIZE=8
TRANSCRIBE_ENABLE_QUALITY_RETRY=true
TRANSCRIBE_ALLOW_MOCK_FALLBACK=false
TRANSCRIBE_MIN_WORDS_PER_SEC=0.45
TRANSCRIBE_RETRY_MIN_DURATION_SEC=90
TRANSCRIBE_LOW_CONFIDENCE_THRESHOLD=0.6
TRANSCRIBE_LOW_CONFIDENCE_RATIO_TRIGGER=0.15
TRANSCRIBE_LOW_CONFIDENCE_MIN_WORDS=30
TRANSCRIBE_PREPROCESS_AUDIO=true
TRANSCRIBE_PREPROCESS_SAMPLE_RATE=16000
TRANSCRIBE_PREPROCESS_FILTER_CHAIN=pan=mono|c0=0.5*c0+0.5*c1
TRANSCRIBE_BACKEND=groq
TRANSCRIBE_FAST_MODE=false
TRANSCRIBE_REUSE_EXISTING_ON_GENERATE=true
TRANSCRIBE_VOCAL_ISOLATION_ENABLED=true
TRANSCRIBE_VOCAL_ISOLATION_BACKEND=auto
TRANSCRIBE_VOCAL_ISOLATION_PROFILES=speech,mixed,music
# Optional: auto probes configured command/api options.
TRANSCRIBE_VOCAL_ISOLATION_FALLBACKS=
TRANSCRIBE_VOCAL_ISOLATION_MODEL=mdx23c
TRANSCRIBE_VOCAL_ISOLATION_MODEL_BS_ROFORMER=bs_roformer
TRANSCRIBE_VOCAL_ISOLATION_MODEL_MDX23C=mdx23c
TRANSCRIBE_VOCAL_ISOLATION_TARGET_STEM=vocals
TRANSCRIBE_VOCAL_ISOLATION_DEVICE=auto
TRANSCRIBE_VOCAL_ISOLATION_NICE=10
TRANSCRIBE_VOCAL_ISOLATION_TIMEOUT_SEC=1200
# Generic/local-command backend (used when backend=command|bs_roformer|mdx23c).
# Placeholders: {input} {output_dir} {work_dir} {output_path} {stem} {model} {device}
TRANSCRIBE_VOCAL_ISOLATION_COMMAND=
TRANSCRIBE_VOCAL_ISOLATION_COMMAND_OUTPUT=
TRANSCRIBE_VOCAL_ISOLATION_COMMAND_BS_ROFORMER=python -m bs_roformer_cli --input {input} --output {output_dir} --model {model} --stem {stem} --device {device}
TRANSCRIBE_VOCAL_ISOLATION_COMMAND_OUTPUT_BS_ROFORMER=
TRANSCRIBE_VOCAL_ISOLATION_COMMAND_MDX23C=python -m mdx23c_cli --input {input} --output {output_dir} --model {model} --stem {stem} --device {device}
TRANSCRIBE_VOCAL_ISOLATION_COMMAND_OUTPUT_MDX23C=
# API backend (used when backend=api|bs_roformer_api|mdx23c_api).
TRANSCRIBE_VOCAL_ISOLATION_API_URL=
TRANSCRIBE_VOCAL_ISOLATION_API_URL_BS_ROFORMER=
TRANSCRIBE_VOCAL_ISOLATION_API_URL_MDX23C=
TRANSCRIBE_VOCAL_ISOLATION_API_KEY=
TRANSCRIBE_VOCAL_ISOLATION_API_KEY_HEADER=Authorization
TRANSCRIBE_VOCAL_ISOLATION_API_TIMEOUT_SEC=300
TRANSCRIBE_VOCAL_ISOLATION_API_MODEL=
TRANSCRIBE_VOCAL_ISOLATION_API_MODEL_BS_ROFORMER=
TRANSCRIBE_VOCAL_ISOLATION_API_MODEL_MDX23C=
TRANSCRIBE_VOCAL_ISOLATION_API_FILE_FIELD=file
TRANSCRIBE_VOCAL_ISOLATION_API_MODEL_FIELD=model
TRANSCRIBE_VOCAL_ISOLATION_API_STEM_FIELD=stem
TRANSCRIBE_VOCAL_ISOLATION_API_DEVICE_FIELD=device
TRANSCRIBE_VOCAL_ISOLATION_API_INPUT_MIME=application/octet-stream
TRANSCRIBE_VOCAL_ISOLATION_API_OUTPUT_EXT=wav
TRANSCRIBE_VOCAL_ISOLATION_API_BASE64_FIELD=audio_base64
TRANSCRIBE_VOCAL_ISOLATION_API_PATH_FIELD=
TRANSCRIBE_VOCAL_ISOLATION_API_URL_FIELD=
TRANSCRIBE_VOCAL_ISOLATION_API_EXTRA_FIELDS=
TRANSCRIBE_VOCAL_ISOLATION_API_FORWARD_AUTH_ON_DOWNLOAD=false
TRANSCRIBE_GROQ_MODEL=whisper-large-v3
TRANSCRIBE_GROQ_RETRY_MODEL=whisper-large-v3-turbo
TRANSCRIBE_GROQ_LOCAL_FALLBACK=false
TRANSCRIBE_ROUTER_ENABLED=false
TRANSCRIBE_ROUTER_INDIAN_TO_SARVAM=true
TRANSCRIBE_SARVAM_ALLOW_GROQ_FALLBACK=false
TRANSCRIBE_SARVAM_API_URL=https://api.sarvam.ai/speech-to-text
TRANSCRIBE_SARVAM_API_KEY=
TRANSCRIBE_SARVAM_MODEL=saaras:v3
TRANSCRIBE_SARVAM_MODE=transcribe
TRANSCRIBE_SARVAM_PROMPT=
TRANSCRIBE_SARVAM_WITH_TIMESTAMPS=true
TRANSCRIBE_SARVAM_TIMEOUT_SEC=120
TRANSCRIBE_SARVAM_MAX_WINDOW_SEC=25
TRANSCRIBE_SARVAM_WINDOW_OVERLAP_SEC=0.25
TRANSCRIBE_PROFILE=auto
TRANSCRIBE_PROFILE_ANALYZE_SEC=120
TRANSCRIBE_PROFILE_MIN_ANALYZE_SEC=25
TRANSCRIBE_PROFILE_SILENCE_NOISE_DB=-35
TRANSCRIBE_PROFILE_MIN_SILENCE_SEC=0.35
TRANSCRIBE_PROFILE_SPEECH_MIN_SILENCE_RATIO=0.10
TRANSCRIBE_PROFILE_MUSIC_MAX_SILENCE_RATIO=0.04
TRANSCRIBE_GROQ_ENABLE_RETRY=true
TRANSCRIBE_GROQ_RETRY_MIN_DURATION_SEC=60
TRANSCRIBE_MIN_WORD_DURATION_SEC=0.05
TRANSCRIBE_MAX_WORD_DURATION_SEC=1.2
TRANSCRIBE_WORD_NEXT_GUARD_SEC=0.01
TRANSCRIBE_MAX_WORD_GAP_SEC=24
TRANSCRIBE_GAP_CHECK_MIN_WORDS=20
TRANSCRIBE_GAP_FILL_MIN_SEC=8
TRANSCRIBE_GAP_FILL_PAD_SEC=0.18
TRANSCRIBE_SPARSE_WINDOW_SEC=20
TRANSCRIBE_SPARSE_WINDOW_MIN_WORDS=4
TRANSCRIBE_SPARSE_WINDOW_STEP_SEC=10
TRANSCRIBE_SPARSE_WINDOW_START_SEC=20
TRANSCRIBE_MIN_GAP_FILL_WORDS=3
TRANSCRIBE_GROQ_PROMPT=
TRANSCRIBE_GROQ_RETRY_PROMPT=
TRANSCRIBE_GROQ_RETRY_TRY_NO_PROMPT=true
TRANSCRIBE_GROQ_PROMPT_SPEECH=
TRANSCRIBE_GROQ_RETRY_PROMPT_SPEECH=
TRANSCRIBE_GROQ_RETRY_TRY_NO_PROMPT_SPEECH=false
TRANSCRIBE_GROQ_PROMPT_MUSIC=
TRANSCRIBE_GROQ_RETRY_PROMPT_MUSIC=
TRANSCRIBE_GROQ_RETRY_TRY_NO_PROMPT_MUSIC=true
TRANSCRIBE_ENABLE_GAP_RESCUE=true
TRANSCRIBE_GROQ_RESCUE_MODEL=
TRANSCRIBE_GROQ_RESCUE_PROMPT=
TRANSCRIBE_RESCUE_MIN_GAP_SEC=10
TRANSCRIBE_RESCUE_MAX_CHUNKS=3
TRANSCRIBE_RESCUE_MAX_WINDOW_SEC=45
TRANSCRIBE_RESCUE_PAD_SEC=0.35
TRANSCRIBE_RESCUE_MIN_GAP_SEC_MUSIC=6
TRANSCRIBE_RESCUE_MAX_CHUNKS_MUSIC=8
TRANSCRIBE_RESCUE_MAX_WINDOW_SEC_MUSIC=12
TRANSCRIBE_RESCUE_PAD_SEC_MUSIC=0.35
TRANSCRIBE_RESCUE_SCRIPT_FILTER=true
TRANSCRIBE_RESCUE_PRIMARY_MIN_ALPHA=40
TRANSCRIBE_RESCUE_PRIMARY_LATIN_RATIO=0.65
TRANSCRIBE_RESCUE_TOKEN_LATIN_MIN_RATIO=0.35
TRANSCRIBE_RESCUE_DROP_NON_ASCII_TOKENS=true
TRANSCRIBE_MIN_RESCUE_ADDED_WORDS=2
TRANSCRIBE_HALLUCINATION_FILTER=true
TRANSCRIBE_HALLUCINATION_STRICT=false
# GROQ_API_KEY=
TRANSCRIBE_VAD_FILTER=false
TRANSCRIBE_REGENERATE_LOW_QUALITY=true
TRANSCRIBE_FILLER_AGGRESSIVE_SINGLE_WORDS=false
TRANSCRIBE_LANGUAGE=
TRANSCRIBE_GROQ_LANGUAGE_FALLBACKS=
TRANSCRIBE_GROQ_LANGUAGE_FALLBACK_MAX_ATTEMPTS=2
TRANSCRIBE_GROQ_EXPLICIT_LANGUAGE_ALLOW_CROSS_FALLBACK=false
TRANSCRIBE_LANGUAGE_SCRIPT_MIN_ALPHA=24
TRANSCRIBE_LANGUAGE_SCRIPT_MIN_RATIO=0.28
TRANSCRIBE_LANGUAGE_SCRIPT_PROTECT_GAP=0.18
TRANSCRIBE_LANGUAGE_SCRIPT_SPARSE_WORDS=4
TRANSCRIBE_RESCUE_ON_LOW_COVERAGE=true
TRANSCRIBE_LANGUAGE_GUARD_RETRY=true
TRANSCRIBE_LANGUAGE_GUARD_MIN_ALPHA=16
TRANSCRIBE_LANGUAGE_GUARD_MIN_RATIO=0.22
TRANSCRIBE_INITIAL_PROMPT=
TRANSCRIPT_CUT_CONTEXT_SEC=0.0
TRANSCRIPT_CUT_MERGE_GAP_SEC=0.08
TRANSCRIPT_CUT_MIN_REMOVAL_SEC=0.0
MAX_TRANSCRIBE_DURATION_SEC=0
MAX_CONCURRENT_RENDER_JOBS=2
MAX_CONCURRENT_INGEST_JOBS=1
BROLL_EXTERNAL_ENABLED=true
BROLL_EXTERNAL_TIMEOUT_SEC=12
BROLL_EXTERNAL_PER_QUERY=8
BROLL_EXTERNAL_MAX_QUERIES=4
BROLL_EXTERNAL_DOWNLOAD_MAX_MB=512
# Free stock providers (optional). Add one or both keys.
# Get key: https://www.pexels.com/api/
PEXELS_API_KEY=
# Get key: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
BROLL_AI_ENABLED=true
BROLL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
BROLL_EMBED_DEVICE=cpu
BROLL_ENTITY_ENABLED=true
BROLL_SEMANTIC_WEIGHT=0.55
BROLL_ENTITY_WEIGHT=0.20
BROLL_METADATA_WEIGHT=0.15
BROLL_DURATION_WEIGHT=0.10
BROLL_CONFIDENCE_AUTOPICK_THRESHOLD=0.78
# Comma-separated terms to suppress unsafe query/candidate content.
BROLL_BLOCKLIST_TERMS=
BROLL_SHORTFORM_MIN_SEC=0.8
BROLL_SHORTFORM_MAX_SEC=2.0
BROLL_AUDIO_REACTIVE_ENABLED=true
BROLL_AUDIO_REACTIVE_WINDOW_SEC=0.24
BROLL_AUDIO_REACTIVE_SAMPLE_RATE=11025
BROLL_AUTO_REFRAME_ENABLED=true
# Optional GenAI fallback when stock confidence is low.
BROLL_GENERATIVE_ENABLED=false
BROLL_GENERATIVE_API_URL=
BROLL_GENERATIVE_API_KEY=
BROLL_GENERATIVE_TIMEOUT_SEC=30
BROLL_GENERATIVE_MODEL=auto
BROLL_GENERATIVE_MIN_EXTERNAL_SCORE=0.64
# Optional cloud planner for B-roll beat planning.
# OpenAI-compatible providers are supported. For Groq:
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=
# BROLL_PLANNER_MODEL=openai/gpt-oss-120b
OPENAI_BASE_URL=
OPENAI_API_KEY=
GROQ_API_KEY=
BROLL_PLANNER_MODEL=
BROLL_PLANNER_TIMEOUT_SEC=25
BROLL_LLM_ENABLED=true
BROLL_RETRIEVAL_MODEL=openai/gpt-oss-120b
BROLL_RETRIEVAL_TIMEOUT_SEC=20
