# Get your keys from https://dashboard.clerk.com → Your App → API Keys
CLERK_SECRET_KEY=

# Database (defaults to local SQLite)
# DATABASE_URL=sqlite:///./app.db

# Gemini API Key (needed for high-quality transliteration)
GEMINI_API_KEY=

# Gemini text model for transliteration (and optionally B-roll planning).
TRANSLITERATION_GEMINI_MODEL=gemini-3.5-flash

# Indic-language B-roll pipeline: translate first, then generate visual queries.
# Existing TRANSCRIBE_SARVAM_API_KEY is also accepted, so you do not need two keys.
SARVAM_API_KEY=
BROLL_SARVAM_TRANSLATE_ENABLED=true
BROLL_SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# Use code-mixed if the transcript blends an Indic language and English.
BROLL_SARVAM_TRANSLATE_MODE=formal
BROLL_RETRIEVAL_PROVIDER=gemini
BROLL_GEMINI_MODEL=gemini-3.5-flash
BROLL_GEMINI_TIMEOUT_SEC=60
# A Sarvam-translated Indic beat already receives Gemini visual planning once.
