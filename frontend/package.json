{
  "name": "clipmind-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:timeline-v2": "playwright test",
    "test:timeline-v2:headed": "playwright test --headed",
    "build:timeline-harness:legacy": "VITE_TIMELINE_CORE_V2=false VITE_TIMELINE_TEST_HARNESS=true TIMELINE_HARNESS_OUT_DIR=dist-timeline-legacy vite build --config vite.timeline.config.ts",
    "build:timeline-harness:v2": "VITE_TIMELINE_CORE_V2=true VITE_TIMELINE_TEST_HARNESS=true TIMELINE_HARNESS_OUT_DIR=dist-timeline-v2 vite build --config vite.timeline.config.ts",
    "verify": "npm run test:unit && npm run build && npm run test:timeline-v2",
    "preview": "vite preview",
    "generate:demos": "bash scripts/generate_use_case_demos.sh && node scripts/capture_product_demo.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "upload:latest": "node scripts/upload-latest-from-downloads.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.8",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "framer-motion": "^12.34.5",
    "lucide-react": "^0.575.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  }
}
